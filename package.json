		"@floating-ui/dom": "^1.6.0",
		"@sveltejs/adapter-cloudflare": "^7.2.3",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@tiptap/core": "^3.3.0",
		"@tiptap/extension-floating-menu": "^3.5.2",
		"@tiptap/pm": "^3.3.0",
		"@tiptap/starter-kit": "^3.3.0",
